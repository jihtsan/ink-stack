{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "items", "sort", "maxVisible"],
  "properties": {
    "title": { "type": "string", "pattern": "^[\\s\\S]{1,40}$" },
    "items": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "done"],
        "properties": {
          "id": { "type": "string", "pattern": "^[\\s\\S]{1,64}$" },
          "text": { "type": "string", "pattern": "^[\\s\\S]{1,120}$" },
          "done": { "type": "boolean" }
        }
      }
    },
    "sort": { "type": "string", "enum": ["manual", "open-first"] },
    "maxVisible": { "type": "integer", "minimum": 1, "maximum": 20 }
  }
}
