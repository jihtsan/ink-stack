{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "showWeekday", "subtitle"],
  "properties": {
    "format": { "type": "string", "enum": ["short", "full", "numeric"] },
    "showWeekday": { "type": "boolean" },
    "subtitle": { "type": "string", "pattern": "^[\\s\\S]{0,40}$" }
  }
}
